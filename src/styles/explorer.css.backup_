/* ============================================================
   GERONIMO — EXPLORER
   Árbol de carpetas y documentos
   ============================================================ */

.exp-root {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg-base);
  overflow: hidden;
}

/* ── Header ────────────────────────────────────────────────── */

.exp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-6);
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
}

.exp-title {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  letter-spacing: var(--tracking-tight);
  margin: 0 0 2px;
  font-family: var(--font-display);
}

.exp-subtitle {
  font-size: var(--text-xs);
  color: var(--text-muted);
  margin: 0;
}

.exp-active-badge {
  color: var(--text-accent);
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
}


/* ── Body: dos paneles ─────────────────────────────────────── */

.exp-body {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.exp-panel-left {
  width: 220px;
  min-width: 180px;
  flex-shrink: 0;
  border-right: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-surface-1);
}

.exp-panel-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.exp-panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
  font-size: 10px;
  font-weight: var(--font-bold);
  color: var(--text-disabled);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
}


/* ── Árbol de carpetas ─────────────────────────────────────── */

.exp-tree {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-1) 0;
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}

.exp-tree::-webkit-scrollbar { width: 3px; }
.exp-tree::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: var(--radius-full);
}

.exp-folder-node {
  user-select: none;
}

.exp-folder-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  height: var(--tree-item-height);
  cursor: pointer;
  border-radius: var(--tree-item-radius);
  margin: 1px var(--space-1);
  padding-right: var(--space-1);
  transition: background var(--duration-fast) var(--ease-default),
              color var(--duration-fast) var(--ease-default);
  color: var(--text-secondary);
  -webkit-font-smoothing: antialiased;
}

.exp-folder-row:hover {
  background: var(--tree-item-hover);
  color: var(--text-primary);
}

.exp-folder-row--active {
  background: var(--tree-item-active);
  color: var(--text-accent);
  border-left: 2px solid var(--accent);
}

.exp-folder-row--active .exp-folder-icon svg {
  stroke: var(--accent);
}

.exp-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  flex-shrink: 0;
  color: var(--text-disabled);
}

.exp-folder-icon {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--_indigo-300);
  opacity: 0.8;
}

.exp-folder-row--active .exp-folder-icon {
  opacity: 1;
}

.exp-folder-name {
  flex: 1;
  font-size: var(--text-sm);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.exp-badge {
  font-size: 10px;
  color: var(--text-disabled);
  background: var(--bg-hover);
  padding: 1px var(--space-1);
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.exp-folder-actions {
  display: flex;
  gap: 2px;
  margin-left: 2px;
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-default);
}

.exp-folder-row:hover .exp-folder-actions {
  opacity: 1;
}

.exp-new-folder-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  height: var(--tree-item-height);
  margin: 1px var(--space-1);
  color: var(--text-tertiary);
}


/* ── Input inline ──────────────────────────────────────────── */

.exp-inline-input {
  flex: 1;
  background: var(--input-bg);
  border: 1px solid var(--border-focus);
  border-radius: var(--radius-xs);
  color: var(--input-text);
  font-size: var(--text-sm);
  font-family: var(--font-body);
  padding: 2px var(--space-1);
  outline: none;
  min-width: 0;
  box-shadow: var(--shadow-focus);
}


/* ── Botones de ícono ──────────────────────────────────────── */

.exp-icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  background: transparent;
  border: none;
  border-radius: var(--radius-xs);
  cursor: pointer;
  color: var(--text-disabled);
  transition: background var(--duration-fast) var(--ease-default),
              color var(--duration-fast) var(--ease-default);
  padding: 0;
  font-size: var(--text-sm);
  line-height: 1;
}

.exp-icon-btn:hover {
  background: var(--bg-active);
  color: var(--text-primary);
}

.exp-icon-btn--danger:hover {
  background: var(--bg-error);
  color: var(--text-error);
}


/* ── Botones ───────────────────────────────────────────────── */

.exp-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 0 var(--space-3);
  height: var(--btn-height-sm);
  border-radius: var(--btn-radius);
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  font-family: var(--font-body);
  cursor: pointer;
  border: none;
  transition: background var(--duration-fast) var(--ease-default),
              box-shadow var(--duration-fast) var(--ease-default);
  letter-spacing: var(--tracking-tight);
  -webkit-font-smoothing: antialiased;
}

.exp-btn--primary {
  background: var(--accent);
  color: var(--btn-primary-text);
  box-shadow: var(--shadow-glow-sm);
}

.exp-btn--primary:hover {
  background: var(--accent-hover);
  box-shadow: var(--shadow-glow);
}

.exp-btn--secondary {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-default);
  color: var(--text-secondary);
}

.exp-btn--secondary:hover {
  background: var(--bg-hover);
  border-color: var(--accent);
  color: var(--accent);
}

.exp-btn--ghost {
  background: transparent;
  border: 1px solid var(--border-default);
  color: var(--text-secondary);
}

.exp-btn--ghost:hover {
  background: var(--bg-hover);
  border-color: var(--border-strong);
  color: var(--text-primary);
}

.exp-btn--danger {
  background: var(--bg-error);
  color: var(--text-error);
  border: 1px solid var(--border-error);
}

.exp-btn--danger:hover {
  background: rgba(239, 68, 68, 0.22);
}

.exp-btn--sm {
  height: 26px;
  padding: 0 var(--space-2);
  font-size: var(--text-xs);
}


/* ── Lista de documentos ───────────────────────────────────── */

.exp-doc-list {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-2);
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}

.exp-doc-list::-webkit-scrollbar { width: 3px; }
.exp-doc-list::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: var(--radius-full);
}

.exp-doc-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  margin-bottom: 2px;
  background: transparent;
  border: 1px solid transparent;
  transition: background var(--duration-fast) var(--ease-default),
              border-color var(--duration-fast) var(--ease-default);
  cursor: default;
}

.exp-doc-row:hover {
  background: var(--bg-surface-1);
  border-color: var(--border-subtle);
}

.exp-doc-icon {
  color: var(--text-disabled);
  flex-shrink: 0;
  display: flex;
  opacity: 0.7;
}

.exp-doc-row:hover .exp-doc-icon {
  opacity: 1;
}

/* Ícono de archivo con badge de extensión */
.exp-file-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
  width: 32px;
  transition: opacity var(--duration-fast) var(--ease-default);
}

.exp-doc-row:hover .exp-file-icon-wrap {
  opacity: 1;
}

.exp-file-ext {
  font-size: 8px;
  font-weight: var(--font-bold);
  font-family: var(--font-mono);
  letter-spacing: 0.04em;
  line-height: 1;
  opacity: 0.85;
}

.exp-doc-info {
  flex: 1;
  min-width: 0;
}

.exp-doc-path {
  font-size: var(--text-sm);
  font-weight: var(--font-medium);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-font-smoothing: antialiased;
}

.exp-doc-meta {
  font-size: var(--text-xs);
  color: var(--text-disabled);
  margin-top: 2px;
  font-variant-numeric: tabular-nums;
}

.exp-doc-actions {
  display: flex;
  gap: var(--space-1);
  flex-shrink: 0;
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-default);
}

.exp-doc-row:hover .exp-doc-actions {
  opacity: 1;
}


/* ── Estado vacío ──────────────────────────────────────────── */

.exp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-10) var(--space-4);
  color: var(--text-disabled);
  font-size: var(--text-sm);
  text-align: center;
  gap: var(--space-2);
}


/* ── Modal ─────────────────────────────────────────────────── */

.exp-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--z-modal);
  animation: overlay-in 0.15s var(--ease-default) both;
}

@keyframes overlay-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.exp-modal {
  position: relative;
  background: var(--bg-surface-1);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  width: 380px;
  max-width: 90vw;
  box-shadow: var(--shadow-xl);
  animation: modal-in 0.2s var(--ease-default) both;
}

/* Shimmer border top — misma firma que login card */
.exp-modal::before {
  content: '';
  position: absolute;
  top: -1px; left: 15%; right: 15%;
  height: 1px;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(157, 110, 245, 0.45) 30%,
    rgba(109, 40, 217, 0.70) 50%,
    rgba(157, 110, 245, 0.45) 70%,
    transparent 100%
  );
  border-radius: var(--radius-full);
  pointer-events: none;
}

@keyframes modal-in {
  from { opacity: 0; transform: translateY(8px) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

.exp-modal-title {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  letter-spacing: var(--tracking-tight);
  font-family: var(--font-display);
  margin: 0 0 var(--space-3);
}

.exp-modal-body {
  font-size: var(--text-sm);
  color: var(--text-muted);
  margin: 0 0 var(--space-4);
  line-height: var(--leading-relaxed);
}

.exp-modal-note {
  font-size: var(--text-xs);
  color: var(--text-disabled);
}

.exp-modal-select {
  width: 100%;
  background: var(--input-bg);
  border: 1px solid var(--input-border);
  border-radius: var(--input-radius);
  color: var(--text-primary);
  font-size: var(--text-sm);
  font-family: var(--font-body);
  padding: 0 var(--space-3);
  height: var(--input-height-md);
  margin-bottom: var(--space-4);
  outline: none;
  transition: border-color var(--duration-fast) var(--ease-default),
              box-shadow var(--duration-fast) var(--ease-default);
  box-sizing: border-box;
}

.exp-modal-select:focus {
  border-color: var(--border-focus);
  box-shadow: var(--shadow-focus);
}

.exp-modal-actions {
  display: flex;
  gap: var(--space-2);
  justify-content: flex-end;
  margin-top: var(--space-2);
}


/* ── Drill-down: lista de proyectos ────────────────────────── */

.exp-project-list {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-2);
}

.exp-project-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  margin-bottom: 2px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: background var(--duration-fast) var(--ease-default),
              border-color var(--duration-fast) var(--ease-default);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
}

.exp-project-item:hover {
  background: var(--bg-surface-1);
  border-color: var(--border-subtle);
}

.exp-project-item--active {
  background: var(--bg-accent-muted);
  border-color: var(--border-accent);
  border-left: 2px solid var(--accent);
}

.exp-project-item-icon {
  display: flex;
  align-items: center;
  color: var(--_indigo-300);
  flex-shrink: 0;
  opacity: 0.8;
}

.exp-project-item--active .exp-project-item-icon {
  opacity: 1;
  color: var(--text-accent);
}

.exp-project-item--active .exp-project-item-name {
  color: var(--text-accent);
}

.exp-project-item--active .exp-project-item-desc {
  color: var(--text-tertiary);
}

.exp-project-item-info {
  flex: 1;
  min-width: 0;
}

.exp-project-item-name {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color var(--duration-fast) var(--ease-default);
}

.exp-project-item:hover .exp-project-item-name {
  color: var(--text-accent);
}

.exp-project-item-desc {
  font-size: var(--text-xs);
  color: var(--text-disabled);
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.exp-project-item-arrow {
  color: var(--text-disabled);
  flex-shrink: 0;
  display: flex;
  align-items: center;
}


/* ── Botón volver (drill-down) ─────────────────────────────── */

.exp-back-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--text-accent);
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  font-family: var(--font-body);
  padding: 0;
  transition: opacity var(--duration-fast) var(--ease-default);
  -webkit-font-smoothing: antialiased;
}

.exp-back-btn:hover {
  opacity: 0.75;
}

/* ── Project item actions (edit/delete on hover) ─────────── */
.exp-project-item-actions {
  display: flex;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
}

.exp-project-item-actions .exp-icon-btn {
  opacity: 0;
  transition: opacity var(--duration-fast) var(--ease-default);
}

.exp-project-item:hover .exp-project-item-actions .exp-icon-btn {
  opacity: 0.7;
}

.exp-project-item-actions .exp-icon-btn:hover {
  opacity: 1 !important;
}

/* ── Breadcrumb navegación ─────────────────────────────────── */
.exp-breadcrumb {
  display: flex;
  align-items: center;
  gap: 2px;
  flex-wrap: wrap;
}

.exp-bc-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--text-accent);
  font-size: var(--text-xs);
  font-weight: var(--font-medium);
  font-family: var(--font-body);
  padding: 2px 4px;
  border-radius: var(--radius-xs);
  transition: background var(--duration-fast);
}

.exp-bc-btn:hover {
  background: var(--bg-accent-subtle);
}

.exp-bc-sep {
  color: var(--text-disabled);
  font-size: var(--text-xs);
  padding: 0 2px;
  user-select: none;
}

.exp-bc-current {
  font-size: var(--text-xs);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  padding: 2px 4px;
}

/* ══ MOBILE RESPONSIVE ══════════════════════════════════════ */
@media (max-width: 768px) {
  .exp-header {
    padding: var(--space-3) var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Dos paneles → columna única */
  .exp-body {
    flex-direction: column;
  }

  /* Panel árbol: ancho completo, altura limitada */
  .exp-panel-left {
    width: 100%;
    min-width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--border-subtle);
    max-height: 200px;
    flex-shrink: 0;
  }

  /* Panel docs: ocupa el resto */
  .exp-panel-right {
    flex: 1;
    min-height: 0;
  }

  /* Botones de acción: más espacio para tocar */
  .exp-icon-btn {
    width: 32px;
    height: 32px;
  }

  /* Acciones de carpeta/doc: siempre visibles en mobile */
  .exp-folder-actions,
  .exp-doc-actions {
    opacity: 1;
  }

  /* Docs: padding reducido */
  .exp-doc-row {
    padding: var(--space-3) var(--space-2);
  }

  /* Modal: full width en mobile */
  .exp-modal {
    width: 95vw;
    padding: var(--space-4);
  }

  /* Botones del modal: full width */
  .exp-modal-actions {
    flex-direction: column-reverse;
  }

  .exp-modal-actions .exp-btn {
    width: 100%;
    justify-content: center;
  }

  /* Breadcrumb: texto más pequeño */
  .exp-bc-btn,
  .exp-bc-sep,
  .exp-bc-current {
    font-size: 10px;
  }
}

@media (max-width: 768px) {
  .exp-btn--sm {
    height: auto;
    padding: 6px var(--space-3);
    white-space: nowrap;
    line-height: 1.4;
  }
}

.exp-doc-row--selected {
  background: var(--accent-dim, rgba(99,102,241,0.12)) !important;
  border-color: var(--accent) !important;
}

/* ── Empty states ────────────────────────────────────────────────────────── */
.exp-empty-state, .exp-docs-empty {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: var(--space-10) var(--space-6);
  text-align: center; gap: var(--space-2);
}
.exp-empty-title, .exp-docs-empty-title {
  font-size: var(--text-base); font-weight: var(--font-semibold);
  color: var(--text-secondary); margin: 0; -webkit-font-smoothing: antialiased;
}
.exp-empty-desc, .exp-docs-empty-desc {
  font-size: var(--text-sm); color: var(--text-muted);
  max-width: 320px; line-height: var(--leading-relaxed); margin: 0;
}
.exp-empty-hint, .exp-docs-empty-hint {
  font-size: var(--text-xs); color: var(--text-disabled);
  font-style: italic; margin-top: var(--space-1);
}
.exp-folders-empty { padding: var(--space-5) var(--space-4); text-align: center; }
.exp-folders-empty-title {
  font-size: var(--text-sm); font-weight: var(--font-semibold);
  color: var(--text-tertiary); margin: 0 0 var(--space-1);
}
.exp-folders-empty-desc { font-size: var(--text-xs); color: var(--text-muted); line-height: var(--leading-relaxed); margin: 0; }

/* ── Selection system ─────────────────────────────────────────────────────── */
.exp-doc-checkbox { width:15px;height:15px;flex-shrink:0;border:1.5px solid var(--border-default);border-radius:3px;display:flex;align-items:center;justify-content:center;transition:all var(--duration-fast);cursor:pointer;background:transparent; }
.exp-doc-checkbox:hover { border-color:var(--border-accent);background:var(--bg-accent-subtle); }
.exp-doc-checkbox--checked { border-color:var(--accent);background:var(--accent); }
.exp-doc-row--selected { background:var(--bg-accent-subtle) !important; }
.exp-doc-row--selected .exp-doc-path { color:var(--text-primary);font-weight:var(--font-medium); }

.exp-hint-bar { display:flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-4);background:var(--bg-surface-2);border-top:1px solid var(--border-subtle);font-size:var(--text-xs);color:var(--text-disabled);flex-shrink:0;-webkit-font-smoothing:antialiased; }

.exp-selection-bar { display:flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-3);background:var(--bg-surface-1);border-top:1px solid var(--border-accent);flex-shrink:0;flex-wrap:wrap;animation:exp-sel-in 0.2s var(--ease-spring) both; }
@keyframes exp-sel-in { from{transform:translateY(6px);opacity:0} to{transform:translateY(0);opacity:1} }

.exp-sel-count { font-size:var(--text-xs);font-weight:var(--font-semibold);color:var(--text-accent);background:var(--bg-accent-muted);border:1px solid var(--border-accent);padding:2px var(--space-2);border-radius:var(--radius-full);flex-shrink:0;-webkit-font-smoothing:antialiased; }
.exp-sel-hint { font-size:var(--text-xs);color:var(--text-muted);flex:1;min-width:0;-webkit-font-smoothing:antialiased; }

.exp-sel-btn { display:inline-flex;align-items:center;gap:var(--space-1);padding:0 var(--space-3);height:var(--btn-height-sm);border-radius:var(--btn-radius);font-family:var(--font-body);font-size:var(--text-xs);font-weight:var(--font-semibold);cursor:pointer;white-space:nowrap;flex-shrink:0;transition:var(--transition-fast);-webkit-font-smoothing:antialiased; }
.exp-sel-btn--primary { background:var(--accent);color:var(--btn-primary-text);border:none; }
.exp-sel-btn--primary:hover { background:var(--accent-hover); }
.exp-sel-btn--ghost { background:var(--bg-surface-2);color:var(--text-secondary);border:1px solid var(--border-default); }
.exp-sel-btn--ghost:hover { background:var(--bg-hover);color:var(--text-primary); }
.exp-sel-btn--clear { background:transparent;color:var(--text-disabled);border:none;padding:0 var(--space-1); }
.exp-sel-btn--clear:hover { color:var(--text-muted); }

/* ── Analysis Modal ───────────────────────────────────────────────────────── */
.exp-modal-overlay { position:fixed;inset:0;background:var(--bg-overlay);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:var(--z-modal);padding:var(--space-5); }
.exp-analysis-modal { background:var(--bg-surface-1);border:1px solid var(--border-default);border-radius:var(--modal-radius);width:480px;max-width:96vw;box-shadow:var(--shadow-xl);overflow:hidden; }
.exp-analysis-header { display:flex;align-items:flex-start;gap:var(--space-3);padding:var(--space-5) var(--space-5) var(--space-4);border-bottom:1px solid var(--border-subtle); }
.exp-analysis-title { font-size:var(--text-base);font-weight:var(--font-semibold);color:var(--text-primary);margin:0 0 var(--space-2);-webkit-font-smoothing:antialiased; }
.exp-analysis-docs { display:flex;flex-wrap:wrap;gap:var(--space-1); }
.exp-analysis-doc-chip { display:inline-flex;align-items:center;gap:var(--space-1);padding:2px var(--space-2);background:var(--bg-surface-2);border:1px solid var(--border-subtle);border-radius:var(--radius-sm);font-size:var(--text-xs);color:var(--text-secondary);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.exp-modal-close { display:flex;align-items:center;justify-content:center;width:24px;height:24px;background:none;border:none;border-radius:var(--radius-sm);cursor:pointer;color:var(--text-disabled);transition:background var(--duration-fast),color var(--duration-fast);flex-shrink:0;padding:0; }
.exp-modal-close:hover { background:var(--bg-hover);color:var(--text-primary); }
.exp-analysis-grid { display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border-subtle); }
.exp-analysis-action { display:flex;align-items:flex-start;gap:var(--space-3);padding:var(--space-4);background:var(--bg-surface-1);cursor:pointer;border:none;text-align:left;font-family:var(--font-body);transition:background var(--duration-fast);width:100%; }
.exp-analysis-action:hover:not(:disabled) { background:var(--bg-hover); }
.exp-analysis-action--disabled { opacity:0.4;cursor:not-allowed; }
.exp-analysis-action--full { grid-column:span 2;background:var(--bg-accent-subtle); }
.exp-analysis-action--full:hover { background:var(--bg-accent-muted) !important; }
.exp-action-icon { width:30px;height:30px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.exp-action-title { font-size:var(--text-sm);font-weight:var(--font-semibold);color:var(--text-primary);margin-bottom:2px;-webkit-font-smoothing:antialiased; }
.exp-action-desc { font-size:var(--text-xs);color:var(--text-muted);line-height:var(--leading-snug); }
.exp-action-need { font-size:10px;color:var(--text-disabled);margin-top:2px;font-style:italic; }
.exp-analysis-footer { display:flex;justify-content:flex-end;padding:var(--space-3) var(--space-5);border-top:1px solid var(--border-subtle); }
